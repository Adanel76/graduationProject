# Локальная SMTP-конфигурация. Создайте рядом файл backend/.env.local
# и впишите реальные значения. Этот файл лучше не переносить в архивы.

EMAIL_ENABLED=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_FROM=your-email@gmail.com
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-google-app-password
EMAIL_FROM_NAME=Travel Agency
