APP_NAME=Tourism Agency API
APP_VERSION=1.0.0

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tourism_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=tourism_db

SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

AUTO_CREATE_TABLES=true
AUTO_SEED_REFERENCE_DATA=true
AUTO_SEED_DEMO_DATA=false

CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_BASE_URL=http://localhost:3000

# Email delivery
# Лучше хранить реальные SMTP-данные в backend/.env.local,
# чтобы они не перезаписывались при обновлении проекта.
# Для Gmail нужен пароль приложения, а не обычный пароль аккаунта.
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_FROM=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=Travel Agency
