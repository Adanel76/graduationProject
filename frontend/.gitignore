# Создание .gitignore
cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.env
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Database
*.db
*.sqlite3

# Node.js (frontend)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build
dist/
build/

# Logs
*.log

# Environment variables
.env.local
.env.*.local

# Temporary files
*.tmp
*.temp
EOF
